<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/stato.owl"/>

    <!-- Root: OBI_0200000 data transformation -->
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0200000">
        <rdfs:label>data transformation</rdfs:label>
    </owl:Class>

    <!-- Mid-level: OBI_0000673 statistical hypothesis test, child of root -->
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000673">
        <rdfs:label>statistical hypothesis test</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0200000"/>
    </owl:Class>

    <!-- Leaf: STATO_0000304 Student's t-test, child of OBI_0000673 -->
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000304">
        <rdfs:label>Student's t-test</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000673"/>
    </owl:Class>

    <!-- Deprecated class under the root — must be skipped by ingestion -->
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_0000001">
        <rdfs:label>deprecated statistical test</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0200000"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>

    <!-- Unrelated class NOT under the root — must NOT be ingested -->
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/STATO_9999999">
        <rdfs:label>unrelated concept</rdfs:label>
    </owl:Class>

</rdf:RDF>
